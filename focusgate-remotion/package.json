{
  "name": "focusgate-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "FocusGate 30-second promo video — Remotion composition, exported at 1080x1920 (Reels/Shorts) and 1920x1080 (YouTube).",
  "scripts": {
    "dev": "remotion studio",
    "render:vertical": "remotion render src/index.ts FocusGateVertical out/focusgate-vertical.mp4",
    "render:horizontal": "remotion render src/index.ts FocusGateHorizontal out/focusgate-horizontal.mp4",
    "render:all": "npm run render:vertical && npm run render:horizontal",
    "still": "remotion still src/index.ts FocusGateVertical out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
